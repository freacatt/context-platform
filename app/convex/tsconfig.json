{
  /* Convex functions are bundled by the Convex CLI; this config is for type-checking only. */
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.convex.tsbuildinfo",
    "noUnusedLocals": true
  },
  "include": ["./**/*", "../shared/**/*"],
  "exclude": ["./_generated"]
}
